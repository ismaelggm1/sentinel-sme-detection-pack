// ============================================================
// RULE: CA-001 — LSASS Memory Access (Credential Dumping)
// ============================================================
// MITRE ATT&CK:  T1003.001 — OS Credential Dumping: LSASS Memory
// Severity:      HIGH
// Data Source:   DeviceProcessEvents (Microsoft Defender for Endpoint)
// Frequency:     Every 15 minutes | Lookback: 1 hour
// Author:        Ismael Gaton
//
// Description:
//   Detects attempts to access LSASS process memory — the primary
//   method used by Mimikatz, ProcDump, and similar tools to extract
//   plaintext credentials and NTLM hashes from memory.
//   Any access to LSASS from non-system processes is highly suspicious.
//
// NOTE: Near-zero false positive rate. LSASS dumping is almost never
// legitimate in an SME environment outside of authorized red team exercises.
// ============================================================

// --- CONFIGURATION ---
let LookbackWindow = 1h;
// --- END CONFIGURATION ---

DeviceProcessEvents
| where TimeGenerated > ago(LookbackWindow)
| where (
    // ProcDump targeting LSASS
    (FileName =~ "procdump.exe" and ProcessCommandLine has "lsass")
    // comsvcs.dll MiniDump technique (fileless dump)
    or (FileName =~ "rundll32.exe"
        and ProcessCommandLine has "comsvcs"
        and ProcessCommandLine has "MiniDump")
    // Task Manager manual dump (rare but happens)
    or (FileName =~ "taskmgr.exe" and ProcessCommandLine has "lsass")
    // Mimikatz keyword patterns
    or (ProcessCommandLine has_any (
        "sekurlsa", "lsadump", "kerberos::list", "privilege::debug",
        "token::elevate", "lsass.dmp"
    ))
)
| extend
    AlertTitle = "LSASS credential dumping attempt detected",
    Severity = "High",
    MITRE_Tactic = "Credential Access",
    MITRE_Technique = "T1003.001"
| project
    TimeGenerated,
    DeviceName,
    AccountName,
    FileName,
    ProcessCommandLine,
    InitiatingProcessFileName,
    FolderPath,
    AlertTitle,
    Severity,
    MITRE_Tactic,
    MITRE_Technique

// ============================================================
// TUNING NOTES:
//   - Security testing / red team exercises will trigger this.
//     Coordinate with your team and exclude by DeviceName temporarily.
//   - EDR solutions (CrowdStrike, SentinelOne) also alert on this.
//     Correlate with EDR for additional context.
//   - The comsvcs MiniDump technique is the most common in the wild
//     as it uses a Windows-native DLL and often evades basic AV.
//
// RESPONSE:
//   1. CRITICAL — isolate device immediately via MDE
//   2. Assume ALL credentials on that host are compromised
//   3. Force password reset for all accounts that logged into that machine
//   4. Check for lateral movement FROM that device in the next 24hrs
//   5. If AD environment: run klist purge equivalent across impacted accounts
// ============================================================


// ============================================================
// RULE: CA-002 — Password Spray Attack Against Azure AD
// ============================================================
// MITRE ATT&CK:  T1110.003 — Brute Force: Password Spraying
// Severity:      HIGH
// Data Source:   SigninLogs (Azure Active Directory connector)
// Frequency:     Every 30 minutes | Lookback: 1 hour
// Author:        Ismael Gaton
//
// Description:
//   Detects password spray — one IP trying the same password against
//   many accounts. Different from brute force (many passwords, one account).
//   Very common attack against M365 SME tenants, especially via legacy auth.
// ============================================================

// --- CONFIGURATION ---
let LookbackWindow = 1h;
let SprayThreshold = 10;  // Distinct accounts attempted from same IP
                          // Raise to 15-20 for large shared-NAT environments
// --- END CONFIGURATION ---

SigninLogs
| where TimeGenerated > ago(LookbackWindow)
| where ResultType != 0  // Failed sign-ins only
| where ResultType in (
    "50126",   // Invalid username or password
    "50053",   // Account locked out
    "50055",   // Password expired
    "50056"    // Null or empty password
)
| summarize
    AttemptedAccounts = dcount(UserPrincipalName),
    AccountList = make_set(UserPrincipalName, 20),
    AttemptCount = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by IPAddress, AppDisplayName
| where AttemptedAccounts >= SprayThreshold
| extend
    DurationMinutes = datetime_diff('minute', LastSeen, FirstSeen),
    AlertTitle = "Password spray detected — one IP targeting multiple accounts",
    Severity = "High",
    MITRE_Tactic = "Credential Access",
    MITRE_Technique = "T1110.003"
| project
    FirstSeen,
    LastSeen,
    DurationMinutes,
    IPAddress,
    AppDisplayName,
    AttemptedAccounts,
    AttemptCount,
    AccountList,
    AlertTitle,
    Severity,
    MITRE_Tactic,
    MITRE_Technique
| order by AttemptedAccounts desc

// ============================================================
// TUNING NOTES:
//   - VPN/NAT environments with many users on one IP will FP here.
//     Exclude known corporate egress IPs:
//     | where IPAddress !in ("x.x.x.x", "y.y.y.y")
//   - After a spray, always check if any account in AccountList
//     had a successful login shortly after — that confirms success.
//   - Legacy auth protocols (SMTP, IMAP, POP3) are spray favorites.
//     Consider blocking legacy auth via Conditional Access entirely.
//
// RESPONSE:
//   1. Block the source IP via Conditional Access or Azure AD named locations
//   2. Check if any account in AccountList had a successful login post-spray
//   3. If yes — treat as active compromise (see IA-003 playbook)
//   4. Enable MFA for all accounts if not already enforced
//   5. Check for legacy authentication protocols still enabled
// ============================================================


// ============================================================
// RULE: CA-003 — Kerberoasting Activity
// ============================================================
// MITRE ATT&CK:  T1558.003 — Steal or Forge Kerberos Tickets: Kerberoasting
// Severity:      HIGH
// Data Source:   SecurityEvent (Event ID 4769)
//                Requires: Audit Kerberos Service Ticket Operations — Success+Failure
// Frequency:     Every 1 hour | Lookback: 2 hours
// Author:        Ismael Gaton
//
// Description:
//   Detects Kerberoasting — requesting multiple Kerberos service tickets
//   in a short period using weak RC4 encryption. Attackers request TGS
//   tickets for service accounts and crack them offline.
//
// FIELD NOTE: TicketEncryptionType is stored as a string in most Sentinel
// workspaces. The value "0x17" corresponds to RC4-HMAC (weak, crackable).
// If your workspace stores it as integer, use: TicketEncryptionType == 23
// ============================================================

// --- CONFIGURATION ---
let LookbackWindow = 2h;
let RequestThreshold = 3;  // Number of distinct service tickets to trigger
// --- END CONFIGURATION ---

SecurityEvent
| where TimeGenerated > ago(LookbackWindow)
| where EventID == 4769
// RC4-HMAC encryption — stored as string "0x17" in most workspaces
// If this returns 0 results, try: | where TicketEncryptionType == 23
| where TicketEncryptionType has_any ("0x17", "23", "RC4")
| where ServiceName !endswith "$"           // Exclude machine accounts
| where ServiceName !in~ ("krbtgt", "kadmin", "kadmin/changepw")
| where AccountName !endswith "$"           // Exclude machine account requests
| summarize
    ServiceNames = make_set(ServiceName),
    RequestCount = count(),
    FirstRequest = min(TimeGenerated),
    LastRequest = max(TimeGenerated)
    by AccountName, IpAddress
| where RequestCount >= RequestThreshold
| extend
    DurationMinutes = datetime_diff('minute', LastRequest, FirstRequest),
    AlertTitle = "Possible Kerberoasting — multiple TGS tickets with RC4 encryption",
    Severity = "High",
    MITRE_Tactic = "Credential Access",
    MITRE_Technique = "T1558.003"
| project
    FirstRequest,
    LastRequest,
    DurationMinutes,
    AccountName,
    IpAddress,
    RequestCount,
    ServiceNames,
    AlertTitle,
    Severity,
    MITRE_Tactic,
    MITRE_Technique
| order by RequestCount desc

// ============================================================
// TUNING NOTES:
//   - If TicketEncryptionType returns unexpected values in your env,
//     run this first to see what values you have:
//     SecurityEvent | where EventID == 4769 | summarize count() by TicketEncryptionType
//   - Legitimate apps using Kerberos may request service tickets.
//     Check if AccountName is a known application service account.
//   - Focus on REAL user accounts (not service accounts) requesting
//     many tickets — this is the highest risk pattern.
//   - Modern apps use AES (0x12 / 0x11) which is much harder to crack.
//     RC4 requests in a modern environment are inherently suspicious.
//
// RESPONSE:
//   1. Identify which service accounts were targeted (ServiceNames)
//   2. Reset passwords for ALL targeted service accounts immediately
//      Use long random passwords (25+ characters minimum)
//   3. Where possible migrate to Group Managed Service Accounts (gMSA)
//   4. Investigate the source account (AccountName) for compromise
//   5. Check if any cracking activity occurred (network connections to
//      external IPs from the source device around the same time)
// ============================================================
