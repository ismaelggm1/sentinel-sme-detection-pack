// ============================================================
// RULE: IA-002 — Impossible Travel: Sign-in from Two Countries
// ============================================================
// MITRE ATT&CK:  T1078 — Valid Accounts
// Severity:      🔴 HIGH
// Data Source:   Azure AD Sign-in Logs (SigninLogs)
// Frequency:     Every 1 hour | Lookback: 2 hours
// Author:        Ismael Gaton
// Description:
//   Detects when the same user account successfully signs in from
//   two different countries within a timeframe physically impossible
//   for travel. Classic indicator of credential compromise.
//   Very relevant for SMEs using Microsoft 365.
// ============================================================

SigninLogs
| where TimeGenerated > ago(2h)
| where ResultType == 0  // Successful sign-in only
| where isnotempty(LocationDetails)
| extend Country = tostring(LocationDetails.countryOrRegion)
| where isnotempty(Country)
| summarize
    Countries = make_set(Country),
    IPs = make_set(IPAddress),
    SigninCount = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by UserPrincipalName, AppDisplayName
| where array_length(Countries) > 1
| extend
    TimeDiffMinutes = datetime_diff('minute', LastSeen, FirstSeen),
    AlertTitle = "Impossible travel detected — same account signed in from multiple countries",
    Severity = "High",
    MITRE = "T1078"
| project
    FirstSeen,
    LastSeen,
    TimeDiffMinutes,
    UserPrincipalName,
    AppDisplayName,
    Countries,
    IPs,
    SigninCount,
    AlertTitle,
    Severity,
    MITRE
| order by TimeDiffMinutes asc

// ============================================================
// TUNING NOTES:
//   - VPN users will trigger this. Reduce FPs by excluding known
//     corporate VPN IP ranges:
//     | where IPAddress !in ("x.x.x.x", "y.y.y.y")
//   - Remote workers who travel often — add their UPN to exclusion list
//   - Consider adding a minimum TimeDiffMinutes threshold (e.g. < 120)
//     to only fire on physically impossible travel times
//
// RESPONSE:
//   1. Contact the user immediately to verify travel
//   2. If unrecognized, force password reset + revoke all sessions
//   3. Enable MFA if not already enforced
//   4. Check for any mailbox rules or forwarding added
// ============================================================


// ============================================================
// RULE: IA-003 — Successful Sign-in After Multiple Failures
// ============================================================
// MITRE ATT&CK:  T1110.001 — Brute Force: Password Guessing
// Severity:      🔴 HIGH
// Data Source:   Azure AD Sign-in Logs (SigninLogs)
// Frequency:     Every 30 minutes | Lookback: 1 hour
// Author:        Ismael Gaton
// Description:
//   Detects a successful login that follows a high number of
//   failures in a short window. This is the classic pattern of
//   a successful brute force or password spray attack.
//   Extremely relevant for SMEs without strong MFA enforcement.
// ============================================================

let FailureThreshold = 5;
let LookbackWindow = 1h;

let Failures = SigninLogs
| where TimeGenerated > ago(LookbackWindow)
| where ResultType != 0
| summarize FailureCount = count(), LastFailure = max(TimeGenerated)
    by UserPrincipalName, IPAddress;

let Successes = SigninLogs
| where TimeGenerated > ago(LookbackWindow)
| where ResultType == 0
| summarize SuccessTime = min(TimeGenerated)
    by UserPrincipalName, IPAddress;

Failures
| where FailureCount >= FailureThreshold
| join kind=inner (Successes) on UserPrincipalName
| where SuccessTime > LastFailure
| extend
    AlertTitle = "Successful login after multiple failures — possible brute force",
    Severity = "High",
    MITRE = "T1110.001"
| project
    SuccessTime,
    UserPrincipalName,
    IPAddress,
    IPAddress1,
    FailureCount,
    AlertTitle,
    Severity,
    MITRE

// ============================================================
// TUNING NOTES:
//   - Increase FailureThreshold to 10 in environments with users
//     who frequently mistype passwords
//   - Add conditional: | where IPAddress == IPAddress1 if you only
//     want alerts where success and failures came from same IP
//   - Exclude service accounts that legitimately retry:
//     | where UserPrincipalName !endswith "svc@yourdomain.com"
//
// RESPONSE:
//   1. Check if success came from same or different IP as failures
//   2. Contact user — did they just recover from a lockout?
//   3. If IP is unfamiliar, treat as compromise — reset + revoke
//   4. Block the source IP at the firewall level
// ============================================================
